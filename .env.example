# Clé serveur Gemini. Ne jamais préfixer cette variable par NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_a_new_private_key

# Modèle stable, rapide et adapté au chat pédagogique.
GEMINI_MODEL=gemini-3.1-flash-lite

# Second modèle utilisé automatiquement si le premier est limité.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
